# Copy to .env and fill in real values. Never commit .env to git.

# Required: generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Required before running seed.py (set a strong password, change after first login)
ADMIN_INIT_PASSWORD=

# Optional: comma-separated allowed CORS origins (defaults to localhost:4200)
# CORS_ALLOW_ORIGINS=https://yourdomain.com

# Optional: absolute path to SQLite DB file (default: ./restaurant.db)
# DB_PATH=/var/lib/restaurant/restaurant.db

# Production mode: requires CORS_ALLOW_ORIGINS, enables Secure session cookies.
# PRODUCTION=true

# Alternatively enable Secure cookies without full production mode (requires HTTPS)
# SECURE_COOKIES=true

# Opt-in ONLY for local development: allow private-network/*.local CORS origins
# ALLOW_PRIVATE_NETWORK_CORS=true

# Set to true in development to enable /docs and /redoc
# DEBUG=true
